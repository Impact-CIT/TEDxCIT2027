# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/tedxcit2027?retryWrites=true&w=majority

# Admin Portal Credentials (set strong, unique values in backend/.env and Vercel)
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_SESSION_SECRET=replace_with_a_separate_random_secret

# Optional: Anonymous Voices Registration Deadline (ISO format)
# Default is 2027-01-25T23:59:59+05:30
ANONYMOUS_VOICES_DEADLINE=2027-01-25T23:59:59+05:30

