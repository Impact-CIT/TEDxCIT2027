# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/tedxcit2027?retryWrites=true&w=majority

# Admin Portal Password (for /api/admin/submissions and frontend /admin)
ADMIN_PASSWORD=tedxcit2027admin

# Optional: Anonymous Voices Registration Deadline (ISO format)
# Default is 2027-01-25T23:59:59+05:30
ANONYMOUS_VOICES_DEADLINE=2027-01-25T23:59:59+05:30

# Razorpay API Credentials (Obtain from Razorpay Dashboard > Settings > API Keys)
# Once KYC is approved or while testing with Test Mode keys:
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Delegate Pass Pricing (in INR)
# Default test pricing configured as requested:
PASS_PRICE_STUDENT=100
PASS_PRICE_PROFESSIONAL=200
