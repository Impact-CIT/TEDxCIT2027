# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Razorpay API Credentials (Obtain from Razorpay Dashboard > Settings > API Keys)
# Once KYC is approved or while testing with Test Mode keys:
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Delegate Pass Pricing (in INR)
# Default test pricing configured as requested:
PASS_PRICE_STUDENT=100
PASS_PRICE_PROFESSIONAL=200
